{
  "name": "@ai-preneur/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runtime-agnostic contracts shared by web and api: types, constants and Zod schemas.",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
