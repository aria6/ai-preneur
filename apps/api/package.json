{
  "name": "@ai-preneur/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Express + TypeScript API — modular monolith backend.",
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@ai-preneur/database": "workspace:*",
    "@ai-preneur/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
