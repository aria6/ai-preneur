# -----------------------------------------------------------------------------
# AI Preneur — environment configuration
# Copy to `.env` at the repository root:  cp .env.example .env
# The single root `.env` is read by the API, by Drizzle Kit, the seed script and Vite.
# -----------------------------------------------------------------------------

# --- Backend (apps/api) -------------------------------------------------------
NODE_ENV=development
API_HOST=localhost
API_PORT=3000
# Comma-separated list of browser origins allowed to call the API (CORS + CSRF origin check).
# Must contain the exact origin the frontend is served from.
CORS_ORIGIN=http://localhost:5173
# debug | info | warn | error
LOG_LEVEL=info
# Milliseconds to wait for in-flight requests before forcing exit
SHUTDOWN_TIMEOUT_MS=10000
# Behind a reverse proxy / load balancer set the number of proxy hops (e.g. 1),
# otherwise client IPs (used for login rate limiting) are wrong. Keep `false` when exposed directly.
TRUST_PROXY=false

# --- Authentication -------------------------------------------------------------
# Absolute session lifetime and inactivity timeout.
SESSION_TTL_HOURS=168
SESSION_IDLE_TIMEOUT_MINUTES=1440
# Secure (HTTPS-only) session cookie. Defaults to true when NODE_ENV=production.
# SESSION_COOKIE_SECURE=true

# --- Database (packages/database, apps/api) ----------------------------------
# PostgreSQL only: postgres:// or postgresql://
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_preneur
DATABASE_POOL_MAX=10

# --- Social Media AIgency -----------------------------------------------------
# Google API key used to read publicly shared Drive folders ("Siapa saja yang memiliki link").
# Google Cloud Console → APIs & Services → enable "Google Drive API" → Credentials → Create API key.
# Restrict it to the Google Drive API.
GOOGLE_API_KEY=
# Encrypts social media access tokens at rest. Generate ONCE and keep it safe:
#   openssl rand -base64 32
# Changing it later makes stored tokens unreadable (accounts must be reconnected).
SOCIAL_CREDENTIALS_KEY=
# Scheduled-upload worker: true = rows of Terjadwal batches are really uploaded to Instagram.
SOCIAL_PUBLISHER_ENABLED=false
SOCIAL_PUBLISHER_INTERVAL_SECONDS=30

# --- Bank Idea ---------------------------------------------------------------
# Research is done by the Claude Code CLI on this server: install it and log in once
# (`claude` → /login) as the same OS user that runs the API. It uses that account's quota.
# Note: if ANTHROPIC_API_KEY is set in the API's environment, the CLI bills that API key instead.
# One research runs at a time; the rest wait in the queue.
BANK_IDEA_WORKER_ENABLED=true
BANK_IDEA_WORKER_INTERVAL_SECONDS=10
BANK_IDEA_AI_PROVIDER=claude-cli
BANK_IDEA_CLAUDE_BIN=claude
# Optional: model alias passed with --model (e.g. sonnet). Empty = CLI default.
BANK_IDEA_CLAUDE_MODEL=
BANK_IDEA_RESEARCH_TIMEOUT_MINUTES=15

# --- Seed (pnpm db:seed) ------------------------------------------------------
# First Super Admin account. Only used when this email does not exist yet.
# Leave SEED_ADMIN_PASSWORD empty to generate a random one (printed once).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PASSWORD=

# --- Frontend (apps/web) -----------------------------------------------------
# Only VITE_-prefixed variables are exposed to the browser. NEVER put secrets in VITE_ variables.
# `/api` = same origin; the Vite dev server proxies it to API_PROXY_TARGET.
VITE_API_BASE_URL=/api
# Dev-server only (not exposed to the browser): where Vite forwards /api requests.
API_PROXY_TARGET=http://localhost:3000
