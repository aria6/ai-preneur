# -----------------------------------------------------------------------------
# AI Preneur — environment configuration
# Copy to `.env` at the repository root:  cp .env.example .env
# The single root `.env` is read by the API, by Drizzle Kit and by Vite.
# -----------------------------------------------------------------------------

# --- Backend (apps/api) -------------------------------------------------------
NODE_ENV=development
API_HOST=localhost
API_PORT=3000
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# debug | info | warn | error
LOG_LEVEL=info
# Milliseconds to wait for in-flight requests before forcing exit
SHUTDOWN_TIMEOUT_MS=10000

# --- Database (packages/database, apps/api) ----------------------------------
# PostgreSQL only: postgres:// or postgresql://
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_preneur
DATABASE_POOL_MAX=10

# --- Frontend (apps/web) -----------------------------------------------------
# Only VITE_-prefixed variables are exposed to the browser.
# NEVER put secrets in VITE_ variables.
VITE_API_BASE_URL=http://localhost:3000/api
